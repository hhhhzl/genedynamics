<!--
 Tabletop scene for exp3 closed-loop active perception.

 A flat table (0.6 × 0.6 m) with a colored mug-like cylinder on top.
 The camera body `render_cam` is a free-body camera whose pose is set
 per-view by the adapter (`data.cam_xpos / data.cam_xmat`).

 The scene is intentionally minimal: 1 object, 1 camera, no physics
 interactions. The active-perception loop only renders from fixed
 candidate poses — no dynamics are simulated.
-->
<mujoco model="tabletop_scene">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global offwidth="1024" offheight="1024"/>
  </visual>

  <asset>
    <material name="table_mat"  rgba="0.75 0.65 0.5 1"/>
    <material name="mug_mat"    rgba="0.9 0.3 0.2 1"/>
    <material name="handle_mat" rgba="0.95 0.9 0.1 1"/>
    <material name="floor_mat"  rgba="0.3 0.3 0.32 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="2 2 0.01" material="floor_mat"/>

    <!-- Table -->
    <body name="table" pos="0 0 0.30">
      <geom name="table_top" type="box" size="0.30 0.30 0.02" material="table_mat"/>
    </body>

    <!-- Object: mug-like cylinder with a handle -->
    <body name="mug" pos="0.05 0.00 0.40">
      <geom name="mug_body" type="cylinder" size="0.04 0.06" material="mug_mat"/>
      <geom name="mug_handle" type="box" pos="0.05 0.0 0.0" size="0.015 0.010 0.040" material="handle_mat"/>
    </body>

    <!-- Free-body camera; the adapter rewrites pose on each render. -->
    <camera name="render_cam" pos="0.4 0.4 0.6" xyaxes="1 0 0 0 0 1" fovy="60"/>
  </worldbody>
</mujoco>
