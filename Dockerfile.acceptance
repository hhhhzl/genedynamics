# Acceptance test - Linux x86_64 with mujoco/mjx
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libegl1 libgles2 libglfw3 libglvnd0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Minimal deps (no cvxopt - avoid build failure)
RUN pip install --no-cache-dir \
    numpy scipy pyyaml tqdm \
    "jax[cpu]" jaxlib \
    mujoco mujoco-mjx \
    gymnasium matplotlib pandas seaborn jinja2 imageio einops gym

ENV MUJOCO_GL=egl
ENV PYTHONPATH=/app
