                    <joint name="joint7" damping="2" />
                    <site name="ee" pos="0 0 0.107" size="0.01" rgba="0 1 0 1" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" />
