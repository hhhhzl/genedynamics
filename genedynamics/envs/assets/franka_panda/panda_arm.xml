  </default>
  <worldbody>
    <light name="top" pos="0 0 2" mode="trackcom" />
    <body name="link0" childclass="panda">
      <!-- base link inertial dropped: link0 is welded to the (immovable) world,
           so its inertia is dynamically inert; brax fuses it into worldbody and
           rejects world inertia. -->
      <body name="link1" pos="0 0 0.333">
        <inertial mass="4.970684" pos="0.003875 0.002081 -0.04762" fullinertia="0.70337 0.70661 0.0091170 -0.00013900 0.0067720 0.019169" />
